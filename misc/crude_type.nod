
crude type thing
{
	gadget;  -- unnamed
	int		width;
	int		height; 
}



type thing  -- fabricated from crude type def
{
	general method
	{
		begin
		{
		}

		use_gadget [eval] = gadget prox [eval,init] ~gadget
		{
			~gadget -> imo.gadget;
		}

		use_width [eval] = int prox [eval,init] ~width
		{
			~width -> imo.width;
		}

		use_height [eval] = int prox [eval,init] ~height
		{
			~height -> imo.height;
		}
	}

	instance
	{
		gadget			[opt];
		int		width	[opt];
		int		height	[opt];
	}
}
