page is_as in ExamplesByNod

[page] type thing
{
	general method
	{
		begin
		{
			imo.x:begin;
		}

		use_x = int prox [eval,init] ~x
		{
			~x -> imo.x;
		}
	}

	instance
	{
		int x;
	}
}


[page] type widget from thing
{
	general method 
	{
		begin
		{
			imo:as_base<thing>:begin;
			imo.y:begin;
		}

		use_y = int prox [eval,init] ~y
		{
			~y -> imo.y;
		}
	}

	instance
	{
		int y;
	}
}


[page] type gadget from widget
{
	general method begin
	{
		imo.z:begin;
	}

	instance
	{
		int z;
	}
}


[page] routine demo ( thing t, widget w )
{
	t:is<object>?()( =bool );			-- warning: always true
	t:is_actual<thing>?()( =bool );		-- ok
	t:is<widget>?()( =bool );			-- ok 

	t:as<object>;						-- warning: random translation to base type
	t:as<widget>[init];					-- ok, verified at runtime
	
	t:as<widget>;						-- ok, transient

	w:is_actual<thing>?()( =bool );		-- warning: always false
	w:is<thing>?()( =bool );			-- warning: always true
	w:is<int>?()( =bool );				-- ok
	w:as_base<thing>;					-- ok 
	w:as<widget>;						-- warning: extraneous translation to same type
	--w:as_base<int>;					-- error: translation type is not a base of lead


	thing prox ~t -> w;					-- warning: local proxy lacks permission

	~t:is<object>?()( =bool );			-- warning: always true
	~t:is<widget>?()( =bool );			-- ok
	~t:is_actual<object>?()( =bool );	-- warning: always false
	~t:is<int>?()( =bool );				-- ok
		
	~t:as<widget>;						-- ok, transient, runtime good
	~t:as<gadget>;						-- ok, transient, runtime void
}

